<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/exprText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minHeight="30dp"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:singleLine="true"
            android:text="0"
            android:textColor="@color/brand_primary"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tap_to_copy"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="C" android:text="C" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="(" android:text="(" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag=")" android:text=")" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="÷" android:text="÷" />

        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="7" android:text="7" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="8" android:text="8" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="9" android:text="9" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="×" android:text="×" />

        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="4" android:text="4" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="5" android:text="5" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="6" android:text="6" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="−" android:text="−" />

        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="1" android:text="1" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="2" android:text="2" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="3" android:text="3" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="+" android:text="+" />

        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="0" android:text="0" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="." android:text="." />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKey" android:tag="⌫" android:text="⌫" />
        <com.google.android.material.button.MaterialButton style="@style/KeypadKeyAccent" android:tag="=" android:text="=" />
    </GridLayout>
</LinearLayout>
